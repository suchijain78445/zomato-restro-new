# ==============================================================================
# Zomato AI Restaurant Recommendation Engine Configuration
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# App Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]
ENVIRONMENT=development

# Frontend Configuration
API_BASE_URL=http://localhost:8000

# Data Paths
DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
DATA_CACHE_PATH=data/processed/restaurants.parquet
METADATA_DIR=data/metadata

# LLM Configuration
# Options for LLM_PROVIDER: groq | openai | ollama | mock
LLM_PROVIDER=groq

# OpenAI Configuration (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Recommendation Parameters
MAX_CANDIDATES_FOR_LLM=25
DEFAULT_TOP_K=5
