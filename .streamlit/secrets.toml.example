# Streamlit Cloud Secrets Configuration Example
# Copy these key-value pairs into Streamlit Community Cloud > Settings > Secrets

LLM_PROVIDER = "groq"
GROQ_API_KEY = "your-groq-api-key-here"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional: OpenAI configuration
# OPENAI_API_KEY = "your-openai-api-key-here"
# OPENAI_MODEL = "gpt-4o-mini"

# Optional: Remote FastAPI URL (Leave empty for Standalone In-Memory mode)
# API_BASE_URL = "https://your-fastapi-backend.onrender.com"
